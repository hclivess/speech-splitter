  "mixed_threshold": 0.2,
  "check_cutoff": true,
  "cutoff_boundary_ms": 50,
  "cutoff_silence_threshold": 0.35,
  "cutoff_action": "rename",
  "hybrid_pause_detection": true,
  "pause_speech_threshold": 0.2,
  "overlength_action": "rename",
  "trim_silence": true,
  "trim_threshold_db": -38.0,
  "trim_chunk_ms": 10,
  "trim_pad_ms": 150
}